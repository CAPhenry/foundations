{
  "name": "hmp-mysql",
  "version": "1.0.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Shared promise-based MySQL and MariaDB access for HogwartsMP server resources.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/main.js",
  "scripts": {
    "build": "esbuild server/main.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.js --legal-comments=inline",
    "test": "node test/database.test.js",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --lib ES2020 types.d.ts",
    "smoke": "node test/bundle.test.js"
  },
  "dependencies": {
    "mysql2": "3.23.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "server": "dist/main.js",
    "priority": -1000,
    "errorBehavior": "stop",
    "exports": [
      "query",
      "prepare",
      "single",
      "scalar",
      "insert",
      "update",
      "transaction",
      "ready",
      "status"
    ]
  }
}
