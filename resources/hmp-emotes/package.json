{
  "name": "hmp-emotes",
  "version": "0.1.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-curated, synchronized emotes with previews, favorites, and replaceable UI.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx test/emotes.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "server": "dist/server.js",
    "client": "dist/client.js",
    "priority": -410,
    "errorBehavior": "stop",
    "exports": ["emotes", "aliases", "favorites", "ui", "status"],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.1.0" },
      { "name": "hmp-lib", "version": "0.1.0" },
      { "name": "hmp-core", "version": "0.1.0" }
    ]
  }
}
