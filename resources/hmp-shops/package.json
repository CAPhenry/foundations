{
  "name": "hmp-shops",
  "version": "0.2.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Server-authoritative shops, stock, currencies and purchase flows for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline",
    "test": "tsx test/shops.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "serverScripts": [
      "dist/server.js"
    ],
    "exports": [
      "shops",
      "currencies",
      "transactions",
      "stock",
      "status"
    ],
    "resourceDependencies": [
      { "name": "hmp-mysql", "version": "0.2.0" },
      { "name": "hmp-lib", "version": "0.2.0" },
      { "name": "hmp-core", "version": "0.2.0" },
      { "name": "hmp-inventory", "version": "0.2.0" },
      { "name": "hmp-ui", "version": "0.2.0" },
      { "name": "hmp-interact", "version": "0.2.0" }
    ],
    "errorBehavior": "stop",
    "priority": -400
  }
}
