{
  "name": "hmp-activities",
  "version": "0.1.0",
  "private": true,
  "author": "HogwartsMP",
  "description": "Reusable activity definitions, public group discovery, role composition, readiness, and session lifecycle for HogwartsMP.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/server.js",
  "scripts": {
    "build": "esbuild server/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/server.js --legal-comments=inline && esbuild client/main.ts --bundle --platform=browser --target=es2022 --format=iife --outfile=dist/client.js --legal-comments=inline",
    "test": "tsx test/activities.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "smoke": "node test/bundle.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "mafiahub": {
    "server": "dist/server.js",
    "client": "dist/client.js",
    "priority": -440,
    "errorBehavior": "stop",
    "exports": ["definitions", "sessions", "invitations", "status"],
    "resourceDependencies": [
      { "name": "hmp-lib", "version": "0.1.0" },
      { "name": "hmp-core", "version": "0.1.0" }
    ]
  }
}
